---
/**
 * Homepage (Figma section 233:4731): who (left), the project wheel (centre), the index (right).
 * Mobile: the wheel fills the screen, the intro lives in the bottom sheet, the index in the TOC handle.
 */
import Base from '../layouts/Base.astro';
import BottomSheet from '../components/home/BottomSheet.astro';
import ProjectWheel from '../components/home/ProjectWheel.astro';
import ProjectToc from '../components/home/ProjectToc.astro';
import TocHandle from '../components/home/TocHandle.astro';
import FooterBar from '../components/home/FooterBar.astro';
import AboutDrawer from '../components/about/AboutDrawer.astro';
import { getPublishedCaseStudies } from '../lib/content';

const entries = await getPublishedCaseStudies();
// Slugs other than the first: a hash naming one of these means "start somewhere else".
const deepLinkSlugs = entries.slice(1).map((entry) => entry.id);
---

<Base class="home h-dvh overflow-hidden bg-surface-page">
  <!--
    Prerender a case study as soon as its card is hovered or pressed: the page, and its cover image, are
    ready before the tap, so the card ⇄ cover transition has nothing to wait for. Prefetch is the fallback.
  -->
  <script type="speculationrules" is:inline slot="head">
    {
      "prerender": [{ "where": { "href_matches": "/work/*" }, "eagerness": "moderate" }],
      "prefetch": [{ "where": { "href_matches": "/work/*" }, "eagerness": "moderate" }]
    }
  </script>
  <!-- The first frame waits for the wheel to be placed (ProjectWheel.astro), so a card can morph (page-transition.js). -->
  <link rel="expect" href="#wheel-placed" blocking="render" slot="head" />
  <script is:inline slot="head" define:vars={{ deepLinkSlugs }}>
    const root = document.documentElement;
    const deepLink = deepLinkSlugs.includes(decodeURIComponent(location.hash.slice(1)));
    if (deepLink) root.dataset.wheelPending = '';
    // Intro (src/scripts/intro): once per session, never with reduced motion or a deep link (/#slug, /?about).
    try {
      const skip =
        deepLink ||
        new URLSearchParams(location.search).has('about') ||
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        sessionStorage.getItem('intro-seen');
      if (!skip) {
        sessionStorage.setItem('intro-seen', '1');
        root.dataset.intro = 'pending';
      }
    } catch {
      // Storage blocked: no intro.
    }
    // Adaptive quality (src/scripts/quality.ts): a slow-device verdict from earlier this session, or Save-Data.
    try {
      if (sessionStorage.getItem('quality-lite') || navigator.connection?.saveData) root.dataset.quality = 'lite';
    } catch {
      // Storage blocked: decided again on this page.
    }
  </script>

  <!--
    Desktop: intro, card and index sit --home-gap (80px) apart at every width. The group is capped at
    --home-max and centred, so a wider screen adds margin, not gap (layout-and-motion.md → Home layout).
  -->
  <div
    class="mx-auto h-dvh desktop:max-w-(--home-max) desktop:grid desktop:grid-cols-(--home-cols) desktop:gap-x-(--home-gap) desktop:px-gutter-inner"
  >
    <div class="desktop:flex desktop:items-center desktop:justify-end">
      <BottomSheet />
    </div>

    <main id="main" class="h-dvh" tabindex="-1">
      <ProjectWheel entries={entries} />
    </main>

    <div class="hidden desktop:flex desktop:items-center" data-intro-reveal="rise">
      <nav aria-label="Projects" class="w-full max-w-side">
        <ProjectToc entries={entries} />
      </nav>
    </div>
  </div>

  <TocHandle entries={entries} />
  <FooterBar />
  <AboutDrawer />
</Base>

<style is:global>
  /*
   * Intro pending (head script above): only the wheel shows until it lands. The chrome is hidden
   * (and not focusable or clickable); CSS reveals it after --intro-failsafe if the intro never runs.
   */
  html[data-intro='pending'] [data-intro-reveal] {
    opacity: 0;
    visibility: hidden;
    animation: intro-failsafe 0s var(--intro-failsafe) forwards;
  }
  @keyframes intro-failsafe {
    to {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
