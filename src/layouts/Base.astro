---
/**
 * Document shell: <head> with per-page SEO/OG from siteSettings plus overrides,
 * font preload, skip link. rules.md → SEO, Accessibility, Performance.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { existsSync } from 'node:fs';
import { getSiteSettings } from '../lib/content';
import pageTransitionSource from '../scripts/page-transition.js?raw';
import '../styles/global.css';

interface Props {
  /** Page title; omitted on the homepage (site name only). */
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  /** Force noindex (dev pages). Preview deployments are always noindex. */
  noindex?: boolean;
  class?: string;
}

const site = await getSiteSettings();
const { title, description = site.description, ogImage = site.defaultOgImage, noindex = false, class: className } = Astro.props;

const fullTitle = title ? site.titleTemplate.replace('%s', title) : site.siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Cloudflare Pages exposes the branch at build time; only `main` is production.
const branch = process.env.CF_PAGES_BRANCH;
const isPreview = branch !== undefined && branch !== 'main';
const robots = noindex || isPreview ? 'noindex, nofollow' : undefined;

// Icons are set in Keystatic (Site settings); a favicon.ico dropped into public/ is linked too (design/assets.md → Favicon).
const hasPublic = (file: string) => existsSync(new URL(`../../public/${file}`, import.meta.url));
const iconTypes: Record<string, string> = { svg: 'image/svg+xml', png: 'image/png', ico: 'image/x-icon', webp: 'image/webp' };
const faviconType = iconTypes[site.favicon.split('.').pop()?.toLowerCase() ?? ''];

const og = ogImage ? await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg' }) : undefined;

// Inlined on every page: drop the comments (the file is plain JS with no strings containing comment markers).
const pageTransition = pageTransitionSource.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '').replace(/\n\s*\n/g, '\n');
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="preload" href="/fonts/GeneralSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    {hasPublic('favicon.ico') && <link rel="icon" href="/favicon.ico" sizes="32x32" />}
    <link rel="icon" href={site.favicon} type={faviconType} />
    {site.appleTouchIcon && <link rel="apple-touch-icon" href={site.appleTouchIcon} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <!--
      Page transitions (src/scripts/page-transition.js). The opt-in is inline so the incoming page has it
      before its first frame, whatever the stylesheet's timing; the script must be registered by then too.
    -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <script is:inline set:html={pageTransition} />
    <slot name="head" />
  </head>
  <body class={className}>
    <a class="skip-link text-label-2 font-medium" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
