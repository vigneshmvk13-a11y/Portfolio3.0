---
/**
 * Document shell: <head> with per-page SEO/OG from siteSettings plus overrides,
 * font preload, skip link. rules.md → SEO, Accessibility, Performance.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getSiteSettings } from '../lib/content';
import '../styles/global.css';

interface Props {
  /** Page title; omitted on the homepage (site name only). */
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  /** Force noindex (dev pages). Preview deployments are always noindex. */
  noindex?: boolean;
  class?: string;
}

const site = await getSiteSettings();
const { title, description = site.description, ogImage = site.defaultOgImage, noindex = false, class: className } = Astro.props;

const fullTitle = title ? site.titleTemplate.replace('%s', title) : site.siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Cloudflare Pages exposes the branch at build time; only `main` is production.
const branch = process.env.CF_PAGES_BRANCH;
const isPreview = branch !== undefined && branch !== 'main';
const robots = noindex || isPreview ? 'noindex, nofollow' : undefined;

const og = ogImage ? await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="preload" href="/fonts/GeneralSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <slot name="head" />
  </head>
  <body class={className}>
    <a class="skip-link text-label-2 font-medium" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
