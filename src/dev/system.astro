---
/**
 * /_system: every token and foundation component. Dev only (injected by astro.config.mjs).
 * Class names are literal strings so Tailwind generates them.
 */
import Base from '../layouts/Base.astro';
import IconButton from '../components/ui/IconButton.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import LogoPill from '../components/ui/LogoPill.astro';
import Badge from '../components/ui/Badge.astro';
import MotionCover from '../components/media/MotionCover.astro';
import User from '../components/icons/User.astro';
import File from '../components/icons/File.astro';
import ChatCircleDots from '../components/icons/ChatCircleDots.astro';
import X from '../components/icons/X.astro';
import Lock from '../components/icons/Lock.astro';
import ArrowLeft from '../components/icons/ArrowLeft.astro';
import ArrowUpRight from '../components/icons/ArrowUpRight.astro';
import { getAbout, getPublishedCaseStudies } from '../lib/content';
import { duration, ease, spring, intro, wheel } from '../lib/motion';

const about = await getAbout();
const studies = await getPublishedCaseStudies();

const surfaces = [
  ['surface-page', 'bg-surface-page'],
  ['surface-raised', 'bg-surface-raised'],
  ['surface-selected', 'bg-surface-selected'],
  ['surface-hover', 'bg-surface-hover'],
  ['surface-caption', 'bg-surface-caption'],
  ['surface-scrim', 'bg-surface-scrim'],
  ['surface-badge', 'bg-surface-badge'],
];
const foregrounds = [
  ['fg-primary', 'text-fg-primary'],
  ['fg-strong', 'text-fg-strong'],
  ['fg-secondary', 'text-fg-secondary'],
  ['fg-tertiary (non-text only)', 'text-fg-tertiary'],
];
const lines = [
  ['line-subtle', 'border-line-subtle'],
  ['line-default', 'border-line-default'],
  ['line-strong', 'border-line-strong'],
  ['indicator', 'border-indicator'],
  ['focus', 'border-focus'],
];
const type = [
  ['text-h4', 'text-h4'],
  ['text-h5', 'text-h5'],
  ['text-body-1', 'text-body-1'],
  ['text-body-2', 'text-body-2'],
  ['text-body-3', 'text-body-3'],
  ['text-label-1', 'text-label-1'],
  ['text-label-2', 'text-label-2'],
  ['text-label-3', 'text-label-3'],
];
const spacing = [
  ['0.5 · 2px', 'w-0.5'],
  ['1 · 4px', 'w-1'],
  ['2 · 8px', 'w-2'],
  ['2.5 · 10px', 'w-2.5'],
  ['3 · 12px', 'w-3'],
  ['4 · 16px', 'w-4'],
  ['5 · 20px', 'w-5'],
  ['6 · 24px', 'w-6'],
  ['8 · 32px', 'w-8'],
  ['10 · 40px', 'w-10'],
  ['12 · 48px', 'w-12'],
  ['15 · 60px', 'w-15'],
  ['20 · 80px', 'w-20'],
  ['gutter-mobile · 20px', 'w-gutter-mobile'],
  ['gutter-inner · 40px', 'w-gutter-inner'],
  ['gutter · 80px', 'w-gutter'],
];
const radii = [
  ['item · 8', 'rounded-item'],
  ['button-sm · 12', 'rounded-button-sm'],
  ['media-sm · 16', 'rounded-media-sm'],
  ['button-lg · 20', 'rounded-button-lg'],
  ['card · 24', 'rounded-card'],
  ['panel · 32', 'rounded-panel'],
  ['full', 'rounded-full'],
];
const icons = { User, File, ChatCircleDots, X, Lock, ArrowLeft, ArrowUpRight };
const sample = studies[0];
const section = 'flex flex-col gap-6 border-t border-line-default pt-10';
const h2 = 'text-body-1 font-medium text-fg-strong';
const caption = 'text-label-3 text-fg-secondary';
---

<Base title="System" noindex class="bg-surface-page">
  <main id="main" class="mx-auto flex max-w-page flex-col gap-12 px-gutter-mobile py-12 desktop:px-gutter">
    <header class="flex flex-col gap-2">
      <h1 class="text-h4 text-fg-primary">Design system</h1>
      <p class="text-body-3">Dev only. Spec: <code>design/tokens.md</code>, <code>design/components.md</code>.</p>
    </header>

    <section class={section}>
      <h2 class={h2}>Colour: surfaces</h2>
      <ul class="grid grid-cols-2 gap-4 tablet:grid-cols-4">
        {surfaces.map(([name, cls]) => (
          <li class="flex flex-col gap-2">
            <span class:list={['h-15 rounded-item border border-line-default', cls]} />
            <span class={caption}>{name}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>Colour: foreground, lines</h2>
      <ul class="flex flex-wrap gap-6">
        {foregrounds.map(([name, cls]) => (
          <li class:list={['text-label-1', cls]}>{name}</li>
        ))}
        <li class="rounded-item bg-surface-caption px-2 text-label-1 text-fg-on-media">fg-on-media</li>
      </ul>
      <ul class="flex flex-wrap gap-4">
        {lines.map(([name, cls]) => (
          <li class:list={['rounded-item border-2 bg-surface-raised p-3', cls, caption]}>{name}</li>
        ))}
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>Typography (General Sans 400 / 500)</h2>
      <ul class="flex flex-col gap-4">
        {type.map(([name, cls]) => (
          <li class="flex flex-col gap-1 desktop:flex-row desktop:items-baseline desktop:gap-6">
            <span class:list={[caption, 'w-gutter shrink-0']}>{name}</span>
            <span class:list={[cls, 'text-fg-primary']}>Simplifying data mapping for enterprise integrations</span>
          </li>
        ))}
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>Spacing (4px grid)</h2>
      <ul class="flex flex-col gap-2">
        {spacing.map(([name, cls]) => (
          <li class="flex items-center gap-4">
            <span class:list={[caption, 'w-20 shrink-0']}>{name}</span>
            <span class:list={['h-3 bg-fg-primary', cls]} />
          </li>
        ))}
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>Radius, effects</h2>
      <ul class="flex flex-wrap gap-4">
        {radii.map(([name, cls]) => (
          <li class="flex flex-col items-center gap-2">
            <span class:list={['size-15 border border-line-strong bg-surface-raised', cls]} />
            <span class={caption}>{name}</span>
          </li>
        ))}
        <li class="flex flex-col items-center gap-2">
          <span class="size-15 rounded-panel bg-surface-raised shadow-panel" />
          <span class={caption}>shadow-panel</span>
        </li>
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>Motion (src/lib/motion.ts)</h2>
      <dl class="grid gap-2 overflow-x-auto rounded-item bg-surface-raised p-4 text-label-3 desktop:grid-cols-[auto_1fr]">
        {Object.entries({ duration, ease, spring, intro, wheel }).map(([name, value]) => (
          <>
            <dt class="font-medium text-fg-strong">{name}</dt>
            <dd><code>{JSON.stringify(value)}</code></dd>
          </>
        ))}
      </dl>
    </section>

    <section class={section}>
      <h2 class={h2}>Icons (Phosphor)</h2>
      <ul class="flex flex-wrap gap-6 text-fg-secondary">
        {Object.entries(icons).map(([name, Icon]) => (
          <li class="flex flex-col items-center gap-2">
            <Icon class="size-icon-md" />
            <span class={caption}>{name}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class={section}>
      <h2 class={h2}>IconButton</h2>
      <div class="flex flex-wrap items-center gap-8">
        <div class="flex flex-col gap-2">
          <div class="flex gap-2">
            <IconButton icon={User} label="About" />
            <IconButton icon={File} label="Resume" href="#" />
            <IconButton icon={ChatCircleDots} label="Contact" href="https://www.linkedin.com/in/vigneshmvk13/" external />
          </div>
          <span class={caption}>sm (desktop intro)</span>
        </div>
        <div class="flex flex-col gap-2">
          <div class="flex gap-2 rounded-item bg-surface-raised">
            <IconButton icon={User} label="About" variant="lg" />
            <IconButton icon={File} label="Resume" variant="lg" />
            <IconButton icon={ChatCircleDots} label="Contact" variant="lg" />
          </div>
          <span class={caption}>lg (mobile sheet)</span>
        </div>
        <div class="flex flex-col gap-2">
          <div class="flex gap-2">
            <IconButton icon={File} label="Resume" variant="lg-outlined" />
            <IconButton icon={ChatCircleDots} label="Contact" variant="lg-outlined" />
          </div>
          <span class={caption}>lg-outlined (drawer)</span>
        </div>
        <div class="flex flex-col gap-2">
          <IconButton icon={X} label="Close" variant="close" />
          <span class={caption}>close</span>
        </div>
      </div>
    </section>

    <section class={section}>
      <h2 class={h2}>Button, Link</h2>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="/" leadingIcon={ArrowLeft}>All work</Button>
        <Button>Request access</Button>
      </div>
      <p class="max-w-prose text-body-2">
        Inline <Link href="/">internal link</Link> and an <Link href="https://www.linkedin.com/in/vigneshmvk13/" external>external link</Link> in prose.
      </p>
    </section>

    <section class={section}>
      <h2 class={h2}>LogoPill, Badge</h2>
      <div class="flex flex-wrap items-center gap-4">
        {about.affiliations.map((a) => <LogoPill src={a.logo} alt={a.name} />)}
        <Badge status="nda" />
        <Badge status="coming-soon" />
        <span class={caption}>live / placeholder → no badge</span>
      </div>
    </section>

    <section class={section}>
      <h2 class={h2}>MotionCover</h2>
      <div class="grid gap-6 desktop:grid-cols-2">
        {sample && (
          <figure class="flex flex-col gap-2">
            <MotionCover
              class="aspect-card rounded-card"
              poster={sample.data.heroVideo.poster}
              alt={sample.data.heroVideo.alt}
              mp4={sample.data.heroVideo.mp4}
              webm={sample.data.heroVideo.webm}
            />
            <figcaption class={caption}>Poster only (no video files yet)</figcaption>
          </figure>
        )}
        <figure class="flex flex-col gap-2">
          <MotionCover class="aspect-card rounded-card" alt="" />
          <figcaption class={caption}>No poster → neutral block + TODO (dev only)</figcaption>
        </figure>
      </div>
    </section>
  </main>
</Base>
