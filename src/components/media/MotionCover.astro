---
/**
 * The only component that renders <video>. design/components.md → MotionCover.
 * Poster <picture> underneath (LCP, alt text); muted looping video on top, aria-hidden.
 * Sources attach lazily and only one cover plays at a time (src/scripts/media.ts).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Todo from '../dev/Todo.astro';

interface Props {
  poster?: ImageMetadata;
  alt: string;
  mp4?: string;
  webm?: string;
  /** Eager, high-priority poster: use for the LCP card only. */
  priority?: boolean;
  /** The active cover plays (when motion and data saving allow). */
  active?: boolean;
  sizes?: string;
  /** A project cover: the homepage card ⇄ case-study cover page transition morphs it (src/scripts/page-transition). */
  transitionCover?: boolean;
  class?: string;
}

const {
  poster,
  alt,
  mp4,
  webm,
  priority = false,
  active = false,
  sizes = '(min-width: 75rem) 553px, calc(100vw - 40px)',
  transitionCover = false,
  class: className,
} = Astro.props;

const hasVideo = Boolean(mp4 || webm);
---

<div
  class:list={['motion-cover relative overflow-hidden bg-surface-selected', className]}
  data-motion-cover
  data-active={active ? '' : undefined}
  data-vt-cover={transitionCover ? '' : undefined}
>
  {
    poster ? (
      <Picture
        src={poster}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[400, 600, 800, 1106, 1600]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <span class="absolute inset-0 grid place-items-center p-4">
        <Todo>cover poster</Todo>
      </span>
    )
  }
  {
    hasVideo && (
      <video
        class="motion-cover__video absolute inset-0 size-full object-cover"
        aria-hidden="true"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        data-webm={webm}
        data-mp4={mp4}
      />
    )
  }
</div>

<style>
  /* Video stays invisible until it's actually playing, so the poster never flashes black. */
  .motion-cover__video {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .motion-cover__video[data-playing] {
    opacity: 1;
  }
</style>

<script>
  import { initMotionCovers } from '../../scripts/media';
  initMotionCovers();
</script>
