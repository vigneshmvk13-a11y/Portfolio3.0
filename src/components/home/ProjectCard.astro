---
/**
 * One card on the project wheel (Figma component set 228:4583).
 * The wheel positions it via data-offset; only the active card (offset 0) is interactive.
 */
import ProjectCardLink from './ProjectCardLink.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  entry: CaseStudy;
  index: number;
  total: number;
  /** Signed distance from the active card on the ring (0 = active). */
  offset: number;
}

const { entry, index, total, offset } = Astro.props;
const active = offset === 0;
---

<article
  class="wheel-card"
  data-wheel-card
  data-index={index}
  data-slug={entry.id}
  data-offset={offset}
  aria-roledescription="slide"
  aria-label={`${entry.data.tocLabel}, ${index + 1} of ${total}`}
  aria-hidden={active ? undefined : 'true'}
  inert={!active}
>
  <ProjectCardLink entry={entry} priority={index === 0} active={active} />
</article>
