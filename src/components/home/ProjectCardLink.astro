---
/**
 * The face of a project card (Figma 348:14015): a link to /work/[slug], a grey frame holding the cover
 * (with the status badge) and the caption below it. Used by the homepage wheel (ProjectCard) and the
 * case-study More projects grid, whose compact card is a row on mobile (Figma 351:9956).
 * design/components.md → ProjectCard.
 */
import MotionCover from '../media/MotionCover.astro';
import Badge from '../ui/Badge.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  entry: CaseStudy;
  /**
   * Small card (More projects). Mobile: a row, thumbnail left, the whole title and "Year • Tags" right, no badge.
   * Desktop: the cover sets the height, title only.
   */
  compact?: boolean;
  priority?: boolean;
  active?: boolean;
  /** Plays whenever near the viewport, alongside others (More projects). */
  autoplay?: boolean;
  sizes?: string;
  class?: string;
}

const { entry, compact = false, priority = false, active = false, autoplay = false, sizes, class: className } = Astro.props;
const { subtitle, cardMeta, year, status, heroVideo } = entry.data;
const showMeta = year || cardMeta;
---

<a
  href={`/work/${entry.id}/`}
  class:list={[
    'group flex overflow-hidden bg-surface-card-mobile p-1 desktop:flex-col desktop:rounded-card desktop:bg-surface-card',
    compact ? 'rounded-media-sm' : 'size-full flex-col rounded-card',
    className,
  ]}
  data-focus-offset="lg"
  data-card-link={entry.id}
>
  <!--
    The page transition morphs only the cover (data-vt-cover): it grows into the case-study cover while the
    frame and caption go with the page. Clipped here, so the hover zoom (scale 1.03) stays inside.
    src/scripts/page-transition.js.
  -->
  <div
    class:list={[
      'relative overflow-hidden',
      compact
        ? 'w-card-thumb shrink-0 rounded-photo desktop:aspect-card-cover desktop:w-auto desktop:rounded-card-inner'
        : 'min-h-0 flex-1 rounded-card-inner',
    ]}
    data-vt-cover
  >
    <MotionCover
      class="size-full transition-[scale] duration-(--duration-slow) ease-out group-hover:scale-103"
      poster={heroVideo.poster}
      alt={heroVideo.alt}
      mp4={heroVideo.mp4}
      webm={heroVideo.webm}
      priority={priority}
      active={active}
      autoplay={autoplay}
      sizes={sizes}
    />
    <Badge
      status={status}
      class:list={['absolute top-3 right-3 desktop:top-4 desktop:right-4', compact && 'max-desktop:hidden']}
      data-card-badge
    />
  </div>
  <div
    class:list={[
      'flex min-w-0',
      compact ? 'flex-1 flex-col gap-1 px-3 py-1 desktop:p-3' : 'shrink-0 items-start p-3 desktop:gap-6 desktop:p-4',
    ]}
    data-card-caption
  >
    <p
      class:list={[
        'min-h-10 min-w-0 flex-1 text-label-2 font-medium text-fg-primary',
        compact ? 'desktop:line-clamp-2' : 'line-clamp-2 desktop:min-h-0 desktop:text-label-1',
      ]}
    >
      {subtitle}
    </p>
    {
      showMeta && compact && (
        <p class="flex min-w-0 gap-0.5 text-label-3 font-regular whitespace-nowrap text-fg-secondary-on-fill desktop:hidden">
          {year && <span class="shrink-0">{year}</span>}
          {year && cardMeta && <span class="shrink-0" aria-hidden="true">•</span>}
          {cardMeta && <span class="truncate">{cardMeta}</span>}
        </p>
      )
    }
    {
      showMeta && !compact && (
        <p class="hidden min-w-0 flex-1 flex-col text-right text-label-1 font-regular text-fg-secondary desktop:flex">
          {year && <span class="truncate font-medium">{year}</span>}
          {cardMeta && <span class="truncate">{cardMeta}</span>}
        </p>
      )
    }
  </div>
</a>
