---
/**
 * The face of a project card (Figma 348:14015): a link to /work/[slug], a grey frame holding the cover, with
 * the status badge and the caption over it. Used by the homepage wheel (ProjectCard) and the case-study More
 * projects grid, whose compact card is a row on mobile (Figma 351:9956). design/components.md → ProjectCard.
 */
import MotionCover from '../media/MotionCover.astro';
import Badge from '../ui/Badge.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  entry: CaseStudy;
  /**
   * Small card (More projects). Mobile: a row, thumbnail left, the whole title and "Year • Tags" right, no badge.
   * Desktop: the cover with the title over it.
   */
  compact?: boolean;
  priority?: boolean;
  active?: boolean;
  /** Plays whenever near the viewport, alongside others (More projects). */
  autoplay?: boolean;
  sizes?: string;
  class?: string;
}

const { entry, compact = false, priority = false, active = false, autoplay = false, sizes, class: className } = Astro.props;
const { subtitle, cardMeta, year, status, heroVideo } = entry.data;
const showMeta = year || cardMeta;
---

<a
  href={`/work/${entry.id}/`}
  class:list={[
    'group flex overflow-hidden p-1 desktop:flex-col desktop:rounded-card',
    compact ? 'rounded-media-sm bg-surface-card' : 'size-full flex-col rounded-card bg-surface-card-mobile desktop:bg-surface-card',
    className,
  ]}
  data-focus-offset="lg"
  data-card-link={entry.id}
>
  <!--
    The page transition morphs the cover (data-vt-cover) into the case-study cover; the caption and badge on it
    are hidden first so they don't grow with it, and fade in as it lands on the way back. The frame goes with
    the page. Clipped here (.card-cover), so the hover zoom (scale 1.03) stays inside. src/scripts/page-transition.js.
  -->
  <div
    class:list={[
      'card-cover relative',
      compact
        ? 'card-cover--compact min-h-22 w-card-thumb shrink-0 desktop:h-50 desktop:min-h-0 desktop:w-auto'
        : 'min-h-0 flex-1',
    ]}
    data-vt-cover
  >
    <MotionCover
      class="size-full transition-[scale] duration-(--duration-slow) ease-out group-hover:scale-103"
      poster={heroVideo.poster}
      alt={heroVideo.alt}
      mp4={heroVideo.mp4}
      webm={heroVideo.webm}
      priority={priority}
      active={active}
      autoplay={autoplay}
      sizes={sizes}
    />
    <Badge
      status={status}
      class:list={['absolute top-2 right-2 desktop:top-3 desktop:right-3', compact && 'max-desktop:hidden']}
      data-card-badge
    />
    <div
      class:list={[
        'card-caption absolute inset-x-0 bottom-0 flex items-start gap-1 px-5 pt-4 pb-5 text-fg-on-media',
        compact ? 'max-desktop:hidden' : 'card-caption--lg desktop:p-6',
      ]}
      data-card-caption
    >
      <span class="card-caption__scrim card-caption__scrim--blur absolute inset-x-0 bottom-0" aria-hidden="true" data-card-blur
      ></span>
      <span class="card-caption__scrim card-caption__scrim--tone absolute inset-x-0 bottom-0" aria-hidden="true" data-card-tone
      ></span>
      <p class:list={['relative line-clamp-2 min-w-0 flex-1 text-label-3 font-medium', !compact && 'desktop:text-label-1']}>
        {subtitle}
      </p>
      {
        showMeta && !compact && (
          <p class="relative hidden min-w-0 flex-1 flex-col text-right text-label-1 desktop:flex">
            {year && <span class="truncate font-medium text-fg-on-media-soft">{year}</span>}
            {cardMeta && <span class="truncate font-regular text-fg-on-media-muted">{cardMeta}</span>}
          </p>
        )
      }
    </div>
  </div>
  {
    compact && (
      <div class="flex min-w-0 flex-1 flex-col gap-3 py-2 pr-3 pl-5 desktop:hidden">
        <p class="min-h-10 min-w-0 flex-1 text-label-2 font-medium text-fg-primary">{subtitle}</p>
        {showMeta && (
          <p class="flex min-w-0 gap-0.5 text-label-3 font-regular whitespace-nowrap text-fg-secondary">
            {year && <span class="shrink-0">{year}</span>}
            {year && cardMeta && (
              <span class="shrink-0" aria-hidden="true">
                •
              </span>
            )}
            {cardMeta && <span class="truncate">{cardMeta}</span>}
          </p>
        )}
      </div>
    )
  }
</a>

<style>
  /*
   * Rounded by clip-path, not overflow + border-radius: clip-path makes the cover the caption blur's backdrop
   * root, so the blur samples the unclipped cover. With a rounded overflow clip it sampled the grey frame
   * outside the corners and smeared it into them as a pale fringe (the corners looked cut off).
   */
  .card-cover {
    clip-path: inset(0 round var(--radius-card-inner));
  }
  @media (width < 75rem) {
    .card-cover--compact {
      clip-path: inset(0 round var(--radius-photo));
    }
  }

  /*
   * The cover behind the text, blurred and darkened in its own colour (global.css --backdrop-caption). The
   * layer rises so it reaches full strength exactly at the text (the caption's top padding, --caption-inset)
   * after its clear guard and eased fade (--mask-caption): no top edge, no band.
   */
  .card-caption {
    --caption-inset: calc(var(--spacing) * 4);
  }
  @media (width >= 75rem) {
    .card-caption--lg {
      --caption-inset: calc(var(--spacing) * 6);
    }
  }
  .card-caption__scrim {
    top: calc(var(--caption-inset) - var(--caption-guard) - var(--caption-fade));
    mask-image: var(--mask-caption);
  }
  /*
   * Two layers: a blur goes see-through near the cover's sides (it pulls in the nothing beyond them), so a
   * darkening in the same filter would fade there and leave lighter strips. The tone layer is per-pixel and
   * stays even to the edges.
   */
  .card-caption__scrim--blur {
    backdrop-filter: blur(var(--blur-caption));
  }
  .card-caption__scrim--tone {
    backdrop-filter: var(--backdrop-caption-tone);
  }
</style>
