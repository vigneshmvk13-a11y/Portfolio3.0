---
/**
 * Who block: name, role, current work, affiliations (Figma 233:4522 desktop, 233:4587 mobile).
 * Mobile: centred, one-line h5. Desktop: left-aligned h4 with a break after the comma.
 */
import LogoPill from '../ui/LogoPill.astro';
import { getAbout } from '../../lib/content';

const { name, role, currently, affiliations } = await getAbout();
---

<div class="flex flex-col items-center gap-5 text-center desktop:items-start desktop:gap-6 desktop:text-left">
  <div class="flex flex-col gap-1 desktop:gap-2">
    <h1 class="text-h5 text-fg-primary desktop:text-h4">
      I'm {name}, <span class="text-fg-secondary desktop:block">{role}</span>
    </h1>
    <p class="text-body-3">{currently}</p>
  </div>
  {
    affiliations.length > 0 && (
      <ul class="flex items-center gap-2" aria-label="Works with">
        {affiliations.map((affiliation, i) => (
          <li class:list={['flex items-center', i === 0 ? 'gap-1' : 'gap-2 desktop:gap-1']}>
            <span class="text-label-1" aria-hidden="true">
              {i === 0 ? '@' : '&'}
            </span>
            <LogoPill src={affiliation.logo} alt={affiliation.name} />
          </li>
        ))}
      </ul>
    )
  }
</div>
