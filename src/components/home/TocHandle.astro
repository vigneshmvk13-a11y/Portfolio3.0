---
/**
 * Mobile TOC (Figma component 2: collapsed 233:4609, expanded 233:4714). One shape that morphs:
 * the right-edge tab grows into the panel and each tick stretches into its project's row while the
 * labels fade in. Press and drag to scrub (the wheel spins to the row under the finger), release to
 * collapse; a tap opens it until a project or the outside is tapped. Server-rendered as the tab, so
 * it matches Figma before any JS. Behaviour: src/scripts/toc-morph.ts; geometry: src/scripts/toc-shape.ts.
 */
import ProjectToc from './ProjectToc.astro';
import { TAB, barAt, shapeAt } from '../../scripts/toc-shape';
import type { CaseStudy } from '../../lib/content';

interface Props {
  entries: CaseStudy[];
  activeIndex?: number;
}

const { entries, activeIndex = 0 } = Astro.props;
// The Figma tab fits five ticks (10px apart); more projects need a taller tab.
const tabPath = shapeAt(0, 0).path;
const ticks = entries.slice(0, 5).map((_, i, all) => barAt(i, all.length, 0, 0, TAB.w, TAB.h));
---

<div class="toc-morph fixed right-0 z-30 desktop:hidden" data-toc-morph data-intro-reveal="edge">
  <!-- Fill, bars and labels share one clip (the outline path), so they can't drift apart mid-morph. -->
  <div class="toc-morph__clip bg-surface-raised" data-toc-clip>
    <svg
      class="toc-morph__svg absolute top-0 right-0"
      width={TAB.w}
      height={TAB.h}
      viewBox={`0 0 ${TAB.w} ${TAB.h}`}
      aria-hidden="true"
      focusable="false"
      data-toc-bars
    >
      <rect class="fill-surface-selected" opacity="0" data-toc-highlight></rect>
      {
        ticks.map((bar, i) => (
          <rect
            x={bar.x}
            y={bar.y}
            width={bar.w}
            height={bar.h}
            rx={bar.rx}
            class={i === activeIndex ? 'fill-indicator' : 'fill-fg-secondary'}
            data-toc-tick={i}
          />
        ))
      }
    </svg>
    <nav id="toc-panel" aria-label="Projects" class="toc-morph__panel" data-toc-panel inert>
      <ProjectToc entries={entries} variant="panel" activeIndex={activeIndex} />
    </nav>
  </div>
  <!-- The 1px outline on top (outside the clip, so the stroke isn't cut in half). -->
  <svg
    class="toc-morph__svg pointer-events-none absolute top-0 right-0"
    width={TAB.w}
    height={TAB.h}
    viewBox={`0 0 ${TAB.w} ${TAB.h}`}
    aria-hidden="true"
    focusable="false"
    data-toc-svg
  >
    <path class="stroke-line-strong" fill="none" stroke-width="1" d={tabPath} data-toc-outline></path>
  </svg>
  <button
    type="button"
    class="toc-morph__handle"
    aria-expanded="false"
    aria-controls="toc-panel"
    aria-label={`Projects, ${activeIndex + 1} of ${entries.length}`}
    data-toc-handle
  ></button>
</div>

<style define:vars={{ tabClip: `path('${tabPath}')` }}>
  /*
   * Anchored to the active card's centre (global.css --wheel-centre-y; Figma: tab centre 352, card 355).
   * Width and height are written by toc-morph.ts while it morphs; these are the tab's (TAB in toc-shape.ts).
   */
  .toc-morph {
    top: var(--wheel-centre-y);
    translate: 0 -50%;
    width: 27px;
    height: 80px;
  }

  /*
   * The shape's fill, clipped to the outline path (toc-morph.ts writes it each frame; at rest it's the
   * tab). The bars and labels inside it are clipped by the same element, so nothing shows outside the
   * rounded corners mid-morph. The outline stroke and the handle's hit area sit outside it.
   */
  .toc-morph__clip {
    position: absolute;
    inset: 0;
    contain: layout paint;
    clip-path: var(--tabClip);
  }

  /* Rows keep their open width while the frame grows, so text never reflows mid-morph. */
  .toc-morph__panel {
    position: absolute;
    top: 50%;
    right: calc(var(--spacing) * 2);
    translate: 0 -50%;
    opacity: 0;
  }
  .toc-morph__panel[inert] {
    pointer-events: none;
  }

  /*
   * The row highlight is the SVG rect (it grows out of the active tick and follows the finger), so the
   * list's own active background is off here; text colour follows the highlight (data-hl).
   */
  .toc-morph :global([data-toc-item]) {
    background-color: transparent;
    color: var(--color-fg-secondary);
  }
  .toc-morph :global([data-toc-item][data-hl]) {
    color: var(--color-fg-primary);
  }

  .toc-morph__handle {
    position: absolute;
    top: 50%;
    right: 0;
    translate: 0 -50%;
    width: 27px;
    height: 80px;
    border: 0;
    background: transparent;
    -webkit-tap-highlight-color: transparent;
  }
  /* Extend the 27px-wide tab to a 44px hit area (rules.md → touch targets). */
  .toc-morph__handle::before {
    content: '';
    position: absolute;
    inset: 0 0 0 calc(var(--spacing) * -4.25);
  }

  /* Pressing and dragging scrubs the list: no page panning, text selection or callout menu. */
  .toc-morph,
  .toc-morph * {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
</style>
