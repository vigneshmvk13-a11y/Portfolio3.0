---
/**
 * Horizontal photo row in About (Figma 280:9424 desktop 170×200, 280:9306 mobile 150×176).
 * A keyboard-scrollable labelled region with Previous / Next glass buttons over the photos
 * (Figma 280:9431 / 280:9479): Next shows until the row reaches its end, Previous once it has left
 * the start (src/scripts/gallery.ts). Both start hidden, so without JS there are no dead buttons.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IconButton from '../ui/IconButton.astro';
import CaretLeft from '../icons/CaretLeft.astro';
import CaretRight from '../icons/CaretRight.astro';
import CaretLeftFill from '../icons/CaretLeftFill.astro';
import CaretRightFill from '../icons/CaretRightFill.astro';

interface Props {
  images: { image: ImageMetadata; alt: string }[];
  /** id of the scrolling row, for the buttons' aria-controls. */
  id: string;
  class?: string;
}

const { images, id, class: className } = Astro.props;
---

{
  images.length > 0 && (
    <div class:list={['gallery relative', className]} data-gallery>
      <div
        id={id}
        class="gallery__track flex snap-x snap-mandatory scroll-px-4 gap-2 overflow-x-auto px-4 desktop:scroll-px-5 desktop:gap-3 desktop:px-5"
        role="region"
        aria-label="Photos"
        tabindex="0"
        data-gallery-track
      >
        {images.map(({ image, alt }) => (
          <Image
            src={image}
            alt={alt}
            width={170}
            height={200}
            densities={[2, 3]}
            fit="cover"
            class="h-gallery-h-sm w-gallery-w-sm shrink-0 snap-start rounded-media-sm object-cover desktop:h-gallery-h desktop:w-gallery-w"
          />
        ))}
      </div>
      <IconButton
        icon={CaretLeft}
        iconFill={CaretLeftFill}
        label="Previous photos"
        variant="glass"
        class="absolute top-1/2 left-4 -translate-y-1/2 desktop:left-6"
        aria-controls={id}
        data-gallery-btn
        data-gallery-prev
        data-hidden
      />
      <IconButton
        icon={CaretRight}
        iconFill={CaretRightFill}
        label="Next photos"
        variant="glass"
        class="absolute top-1/2 right-4 -translate-y-1/2 desktop:right-6"
        aria-controls={id}
        data-gallery-btn
        data-gallery-next
        data-hidden
      />
    </div>
  )
}

<style>
  .gallery__track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  /* Fade in and out at the ends of the row (a state change, so reduced motion makes it instant). */
  .gallery :global([data-gallery-btn]) {
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility var(--duration-fast) allow-discrete,
      scale var(--duration-fast) var(--ease-out);
  }
  .gallery :global([data-gallery-btn][data-hidden]) {
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  import { initGalleries } from '../../scripts/gallery';
  initGalleries();
</script>
