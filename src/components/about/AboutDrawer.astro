---
/**
 * About drawer (Figma 234:5386 desktop, 234:5545 mobile, 234:34225 mobile compact header).
 * Native modal <dialog>: background inert, Esc closes, focus returns to the trigger.
 * Desktop: left panel inset 40px, no scrim (as drawn). Mobile: bottom sheet with a compact
 * sticky header once the banner scrolls away (a state switch, so reduced motion only drops the fade).
 * Content: the `about` singleton.
 */
import { Image } from 'astro:assets';
import IconButton from '../ui/IconButton.astro';
import Todo from '../dev/Todo.astro';
import X from '../icons/X.astro';
import File from '../icons/File.astro';
import ChatCircleDots from '../icons/ChatCircleDots.astro';
import Gallery from './Gallery.astro';
import TimelineRow from './TimelineRow.astro';
import { getAbout, getSiteSettings } from '../../lib/content';
import { renderInline } from '../../lib/inline-markdown';

const about = await getAbout();
const { nav, contact, resume } = await getSiteSettings();
const contactIsExternal = contact.startsWith('https://');
const [firstParagraph, ...otherParagraphs] = about.bio;
---

<dialog id="about" class="about-drawer" aria-labelledby="about-title" closedby="any" data-about>
  <h2 id="about-title" class="sr-only">About {about.name}</h2>

  <!-- Mobile compact header (234:34225): appears once the banner has scrolled away. -->
  <div class="about-compact sticky top-0 z-10 desktop:hidden" aria-hidden="true">
    <div class="relative flex items-start justify-between overflow-hidden rounded-t-panel-inner rounded-b-media-sm p-4">
      {about.banner && <Image src={about.banner} alt="" width={393} height={84} densities={[2]} fit="cover" class="absolute inset-0 size-full object-cover" />}
      {about.avatar && <Image src={about.avatar} alt="" width={52} height={52} densities={[2, 3]} fit="cover" class="relative size-avatar-sm rounded-full object-cover" />}
      <IconButton icon={X} label="Close" variant="close" class="relative" data-about-close tabindex="-1" />
    </div>
  </div>

  <div class="flex flex-col gap-8 desktop:gap-0">
    <div class="flex flex-col gap-6 desktop:gap-0">
      <div class="overflow-hidden rounded-t-panel-inner desktop:rounded-none" data-about-banner>
        <div class="relative flex h-banner items-start justify-end overflow-hidden rounded-b-media-sm p-5 desktop:rounded-none">
          {
            about.banner && (
              <Image src={about.banner} alt={about.bannerAlt} width={576} height={200} densities={[2]} fit="cover" class="absolute inset-0 size-full object-cover" />
            )
          }
          <IconButton icon={X} label="Close" variant="close" class="relative" data-about-close autofocus />
        </div>
        {
          about.avatar && (
            <div class="flex justify-center px-5 desktop:justify-start">
              <Image
                src={about.avatar}
                alt={about.avatarAlt}
                width={140}
                height={140}
                densities={[2, 3]}
                fit="cover"
                class="relative -mt-avatar-overlap size-avatar rounded-full object-cover"
              />
            </div>
          )
        }
      </div>

      <div class="flex flex-col gap-6 desktop:gap-0">
        <div class="flex flex-col gap-5 px-4 desktop:px-5 desktop:py-8">
          {firstParagraph && <p class="text-label-1 font-regular desktop:text-body-2" set:html={renderInline(firstParagraph)} />}
          {otherParagraphs.map((paragraph) => <p class="text-body-3 desktop:text-body-2" set:html={renderInline(paragraph)} />)}
        </div>
        <div class="flex gap-2 px-4 desktop:px-5 desktop:pb-8">
          {resume ? (
            <IconButton icon={File} label={nav.resume} variant="lg-outlined" href={resume} external />
          ) : (
            <Todo class="self-center">resume PDF</Todo>
          )}
          <IconButton icon={ChatCircleDots} label={nav.contact} variant="lg-outlined" href={contact} external={contactIsExternal} />
        </div>
      </div>
    </div>

    <Gallery images={about.gallery} class="scroll-px-4 px-4 desktop:scroll-px-5 desktop:px-5 desktop:pb-8" />

    {
      about.journey.length > 0 && (
        <section aria-labelledby="journey-title" class="flex flex-col gap-8 desktop:gap-0">
          <h3 id="journey-title" class="px-4 text-label-1 font-medium text-fg-strong desktop:px-5 desktop:py-8 desktop:text-body-1">
            Journey so far
          </h3>
          <ol class="flex flex-col gap-3 px-5 pb-5 desktop:pb-10">
            {about.journey.map((row, i) => (
              <TimelineRow {...row} last={i === about.journey.length - 1} />
            ))}
          </ol>
        </section>
      )
    }
  </div>
</dialog>

<style>
  /* ---------- Shell ---------- */
  .about-drawer {
    position: fixed;
    inset: calc(var(--spacing) * 8) 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: var(--spacing);
    border: 1px solid var(--color-line-default);
    border-bottom: 0;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--color-surface-raised);
    color: var(--color-fg-secondary);
    overflow-y: auto;
    overscroll-behavior: contain;

    /* Close: reverse over --duration-base. */
    opacity: 0;
    translate: 0 calc(var(--spacing) * 6);
    transition:
      opacity var(--duration-base) var(--ease-in-out),
      translate var(--duration-base) var(--ease-in-out),
      display var(--duration-base) allow-discrete,
      overlay var(--duration-base) allow-discrete;
  }

  .about-drawer[open] {
    opacity: 1;
    translate: 0 0;
    transition-duration: var(--duration-slow);
  }

  @starting-style {
    .about-drawer[open] {
      opacity: 0;
      translate: 0 calc(var(--spacing) * 6);
    }
  }

  .about-drawer.no-entrance {
    transition: none;
  }

  .about-drawer::backdrop {
    background: var(--color-surface-scrim);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      display var(--duration-base) allow-discrete,
      overlay var(--duration-base) allow-discrete;
  }
  .about-drawer[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .about-drawer[open]::backdrop {
      opacity: 0;
    }
  }

  @media (min-width: 48rem) {
    .about-drawer {
      left: 50%;
      width: min(var(--container-drawer), 100%);
      translate: -50% calc(var(--spacing) * 6);
    }
    .about-drawer[open] {
      translate: -50% 0;
    }
    @starting-style {
      .about-drawer[open] {
        translate: -50% calc(var(--spacing) * 6);
      }
    }
  }

  /* Desktop: left panel, inset 40px, rounded, no scrim (Figma 234:4968). */
  @media (min-width: 75rem) {
    .about-drawer {
      inset: var(--spacing-gutter-inner) auto var(--spacing-gutter-inner) var(--spacing-gutter-inner);
      width: var(--container-drawer);
      padding: 0;
      border: 0;
      border-radius: var(--radius-panel);
      translate: calc(var(--spacing) * -6) 0;
    }
    .about-drawer[open] {
      translate: 0 0;
    }
    @starting-style {
      .about-drawer[open] {
        translate: calc(var(--spacing) * -6) 0;
      }
    }
    .about-drawer::backdrop {
      background: var(--color-transparent);
    }
  }

  /* ---------- Mobile compact header ---------- */
  .about-compact {
    height: 0;
    overflow: visible;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility var(--duration-fast) allow-discrete;
  }
  .about-drawer[data-compact] .about-compact {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  import { initAboutDrawer } from '../../scripts/drawer';
  initAboutDrawer();
</script>
