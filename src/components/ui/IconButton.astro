---
/**
 * Square button with one Phosphor icon. design/components.md → IconButton.
 * Renders <a> when `href` is set, otherwise <button type="button">.
 * Extra attributes (data-*, aria-controls, aria-expanded…) pass through.
 */
import type { HTMLAttributes } from 'astro/types';
import { isExternal } from '../../lib/links';
import { actionSurface } from '../../lib/ui-classes';

type Variant = 'sm' | 'lg' | 'cta' | 'close' | 'glass';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  icon: (props: { class?: string }) => unknown;
  /** Filled glyph shown on hover (Figma 286:12974). */
  iconFill?: (props: { class?: string }) => unknown;
  /** Accessible name; becomes aria-label. */
  label: string;
  variant?: Variant;
  href?: string;
  /** Opens in a new tab and says so in the accessible name. Defaults to true for links to another site. */
  external?: boolean;
}

const { icon: Icon, iconFill: IconFill, label, variant = 'sm', href, external = isExternal(href), class: className, ...rest } = Astro.props;

const variants: Record<Variant, { box: string; icon: string }> = {
  sm: { box: `${actionSurface} p-4 rounded-button-sm border`, icon: 'size-icon-sm' },
  lg: { box: `${actionSurface} p-4 rounded-button-lg border`, icon: 'size-icon-xs' },
  // The homepage's action buttons as one component: `lg` below the desktop breakpoint, `sm` from it (About).
  cta: {
    box: `${actionSurface} p-4 rounded-button-lg border desktop:rounded-button-sm`,
    icon: 'size-icon-xs desktop:size-icon-sm',
  },
  close: { box: `${actionSurface} p-4 rounded-media-sm border`, icon: 'size-icon-sm' },
  // Over photos (Figma 280:9431): frosted grey circle, white caret.
  glass: {
    box: 'p-3 rounded-full border border-line-default bg-surface-glass text-fg-on-media backdrop-blur-glass hover:border-surface-raised hover:bg-surface-raised hover:text-fg-primary',
    icon: 'size-icon-lg',
  },
};

const classes = [
  'group inline-flex shrink-0 items-center justify-center',
  'transition-[border-color,background-color,color,scale] duration-(--duration-fast) ease-out',
  'active:scale-96',
  variants[variant].box,
  className,
];
const accessibleName = external ? `${label} (opens in new tab)` : label;
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      aria-label={accessibleName}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      {...(rest as HTMLAttributes<'a'>)}
    >
      <Icon class:list={[variants[variant].icon, IconFill && 'group-hover:hidden']} />
      {IconFill && <IconFill class:list={[variants[variant].icon, 'hidden group-hover:block']} />}
    </a>
  ) : (
    <button type="button" class:list={classes} aria-label={accessibleName} {...rest}>
      <Icon class:list={[variants[variant].icon, IconFill && 'group-hover:hidden']} />
      {IconFill && <IconFill class:list={[variants[variant].icon, 'hidden group-hover:block']} />}
    </button>
  )
}
