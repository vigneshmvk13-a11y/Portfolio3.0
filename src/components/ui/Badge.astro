---
/** Card status pill (Figma 230:4637 / 230:4652). Renders nothing for statuses without a badge. */
import type { HTMLAttributes } from 'astro/types';
import Lock from '../icons/Lock.astro';

/** Extra attributes (data-*) pass through to the pill. */
interface Props extends HTMLAttributes<'span'> {
  status: 'live' | 'nda' | 'coming-soon' | 'placeholder';
}

const { status, class: className, ...rest } = Astro.props;
const label = status === 'nda' ? 'NDA protected' : status === 'coming-soon' ? 'Coming soon' : null;
---

{
  label && (
    <span
      {...rest}
      class:list={[
        'inline-flex items-center gap-1 py-2 rounded-full bg-surface-badge',
        'text-label-3 font-medium text-fg-strong whitespace-nowrap',
        status === 'nda' ? 'pl-3 pr-4' : 'px-4',
        className,
      ]}
    >
      {status === 'nda' && <Lock class="size-icon-badge" />}
      {label}
    </span>
  )
}
