---
/** Card status pill (Figma 375:10315). Renders nothing for statuses without a badge. */
import type { HTMLAttributes } from 'astro/types';
import Lock from '../icons/Lock.astro';

/** Extra attributes (data-*) pass through to the pill. */
interface Props extends HTMLAttributes<'span'> {
  status: 'live' | 'nda' | 'coming-soon' | 'placeholder';
}

const { status, class: className, ...rest } = Astro.props;
const label = status === 'nda' ? 'NDA protected' : status === 'coming-soon' ? 'Coming soon' : null;
---

{
  label && (
    <span
      {...rest}
      class:list={[
        'inline-flex items-center gap-1 rounded-full border border-line-on-media py-1.5 pr-3 pl-2.5',
        'text-label-3 font-medium whitespace-nowrap',
        status === 'nda' ? 'bg-surface-badge text-fg-badge' : 'bg-surface-badge-soon text-fg-badge-soon',
        className,
      ]}
    >
      {status === 'nda' && <Lock class="size-icon-badge" />}
      {label}
    </span>
  )
}
