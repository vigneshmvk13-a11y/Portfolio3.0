---
/**
 * Context (Figma 290:57503 Fyn desktop, 290:57552 Fyn mobile, 290:57591 / 290:57648 Gyst): the Overview card
 * for case studies without the full sections. The first block is the lead (heading and text), the rest are
 * subheads with text or a bullet list, 48px apart (mobile 32). A closing `note` is one more paragraph of the
 * lead, as drawn for Gyst. The "Label: value" facts sit in the facts row under the cover (CaseHero).
 */
import Eyebrow from './Eyebrow.astro';
import { paragraphs, type CaseStudy } from '../../lib/content';

interface Props {
  context: NonNullable<CaseStudy['data']['context']>;
  /** The facts row above already gives the gap under the cover. */
  afterFacts?: boolean;
}

const { context, afterFacts = false } = Astro.props;
const { blocks, note } = context;
const [lead, ...rest] = blocks;
const leadText = [...paragraphs(lead?.body), ...paragraphs(note)];
const body = 'text-body-3 desktop:text-body-2';
---

<section
  id="context"
  aria-labelledby="context-label"
  class:list={[
    'flex scroll-mt-25 flex-col gap-8 rounded-panel bg-surface-subtle px-6 py-8 desktop:gap-12 desktop:rounded-section desktop:p-22',
    !afterFacts && 'mt-8 desktop:mt-12',
  ]}
  data-case-section
>
  <div class="flex flex-col gap-4 desktop:gap-6">
    <Eyebrow id="context-label">Overview</Eyebrow>
    <div class="flex flex-col gap-2 desktop:gap-3">
      {lead?.heading && <h3 class="text-h6 text-fg-primary desktop:text-h5">{lead.heading}</h3>}
      {
        leadText.length > 0 && (
          <div class="flex flex-col gap-5 desktop:gap-6">
            {leadText.map((p) => (
              <p class={body}>{p}</p>
            ))}
          </div>
        )
      }
    </div>
  </div>
  {
    rest.map((block) => (
      <div class="flex flex-col gap-2 desktop:gap-3">
        <h4 class="text-label-2 font-medium text-fg-primary desktop:text-label-1">{block.heading}</h4>
        {paragraphs(block.body).map((p) => (
          <p class={body}>{p}</p>
        ))}
        {block.items.length > 0 && (
          <ul class:list={['list-disc pl-5 desktop:pl-6', body]}>
            {block.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }
</section>
