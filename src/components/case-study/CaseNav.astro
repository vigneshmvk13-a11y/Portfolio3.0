---
/**
 * Floating project navigation (Figma 234:23100 expanded, 234:31771 collapsed; mobile 234:10068).
 * Previous · Home · Next, wrapping round the homepage order. Collapses to Home while scrolling down,
 * expands on scroll up, at the page end, and when any of its links has focus (src/scripts/case-study/nav.ts).
 * Home sits above the sliding labels. The surface blurs what scrolls under it (backdrop-blur-nav, 40px)
 * and is surface-caption, not Figma's 70% gray/600-ish fill: white text on that is 2.8:1
 * (design/rules.md → Accessibility).
 */
import HouseSimple from '../icons/HouseSimple.astro';
import HouseSimpleFill from '../icons/HouseSimpleFill.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  previous: CaseStudy;
  next: CaseStudy;
  /** Home lands the wheel on this project (no hash for the first one). */
  homeHref: string;
}

const { previous, next, homeHref } = Astro.props;
const pill =
  'group relative flex items-center justify-center rounded-full border border-line-default text-fg-on-media transition-[border-color,background-color,color] duration-(--duration-fast) ease-out hover:border-surface-raised hover:bg-surface-raised hover:text-fg-primary';
const side = `${pill} case-nav__side w-nav-btn px-4 py-3 text-label-1 font-medium`;
---

<nav aria-label="Projects" class="case-nav pointer-events-none fixed inset-x-0 z-20 flex justify-center" data-case-nav>
  <div class="case-nav__bar pointer-events-auto relative flex items-center gap-1 p-1">
    <span aria-hidden="true" class="case-nav__bg absolute inset-y-0 rounded-full bg-surface-caption"></span>
    <a href={`/work/${previous.id}/`} rel="prev" class:list={[side, 'case-nav__prev']} data-case-nav-prev>
      Previous<span class="sr-only">: {previous.data.tocLabel}</span>
    </a>
    <a href={homeHref} class:list={[pill, 'z-10 p-3']} aria-label="All projects" data-case-nav-home>
      <HouseSimple class="size-icon-lg group-hover:hidden" />
      <HouseSimpleFill class="hidden size-icon-lg group-hover:block" />
    </a>
    <a href={`/work/${next.id}/`} rel="next" class:list={[side, 'case-nav__next']} data-case-nav-next>
      Next<span class="sr-only">: {next.data.tocLabel}</span>
    </a>
  </div>
</nav>

<style>
  .case-nav {
    bottom: calc(var(--spacing) * 8 + env(safe-area-inset-bottom));
    /*
     * No view-transition-name here: it would make the nav a backdrop root, and the blur would see nothing
     * behind it. page-transition.js names it (case-nav) only while the page slides, so it stays put.
     */
  }

  /*
   * Collapse (Vignesh, 2026-10-24: quick, no felt delay): Previous / Next fade out (duration-fast) while the
   * surface narrows to Home and they slide under it (duration-base, ease-in-out: starts and ends at rest,
   * no overshoot), all at once. Expand runs it backwards; the labels fade in only once they've slid out
   * from under Home (60% of the slide), so they never show over it. Each state's transition list sets the
   * timing for entering that state.
   *
   * The surface moves its own edges (left / right on an absolutely positioned span, so nothing else lays
   * out) and keeps its real rounded corners.
   * - Not an animated clip-path: iOS Safari draws it badly on a backdrop-filter layer.
   * - Not ease-out: it starts at ~4.5× its average speed (a jerk on an iPhone). ease-in-out starts from rest.
   * - Not two translated halves (compositor-only): with a 40px blur each half sees its own end, so the
   *   halves blurred differently and showed a seam down the middle.
   *
   * Blur: it lives on the surface's ::before, which fades out while the page scrolls (data-scrolling,
   * nav.ts) and back in once it has stopped, so the pill is a plain tint while content streams under it.
   * Opacity of the blur layer, not an animated blur radius.
   * 60fps at 4× CPU (perf-motion.mjs).
   */
  .case-nav__bar {
    --nav-shift: calc(var(--spacing-nav-btn) + var(--spacing));
  }
  .case-nav__bg {
    left: 0;
    right: 0;
    transition:
      left var(--duration-base) var(--ease-in-out),
      right var(--duration-base) var(--ease-in-out);
  }
  .case-nav__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    -webkit-backdrop-filter: blur(var(--blur-nav));
    backdrop-filter: blur(var(--blur-nav));
    transition: opacity var(--duration-base) var(--ease-out);
  }
  [data-case-nav][data-scrolling] .case-nav__bg::before {
    opacity: 0;
    transition-duration: var(--duration-fast);
  }
  .case-nav__side {
    transition:
      translate var(--duration-base) var(--ease-in-out),
      opacity var(--duration-fast) var(--ease-out) calc(var(--duration-base) * 0.6);
  }
  [data-case-nav][data-collapsed]:not(:focus-within) .case-nav__side {
    opacity: 0;
    pointer-events: none;
    transition:
      translate var(--duration-base) var(--ease-in-out),
      opacity var(--duration-fast) var(--ease-out);
  }
  [data-case-nav][data-collapsed]:not(:focus-within) .case-nav__bg {
    left: var(--nav-shift);
    right: var(--nav-shift);
  }
  [data-case-nav][data-collapsed]:not(:focus-within) .case-nav__prev {
    translate: var(--nav-shift) 0;
  }
  [data-case-nav][data-collapsed]:not(:focus-within) .case-nav__next {
    translate: calc(-1 * var(--nav-shift)) 0;
  }

  /* Slow device (src/scripts/quality.ts): no backdrop blur. */
  :global(html[data-quality='lite']) .case-nav__bg::before {
    display: none;
  }
</style>
