---
/**
 * Floating project navigation (Figma 234:23100, mobile 234:10068). Previous · Home · Next, wrapping round
 * the homepage order. Always in full (no collapsed state since 2026-10-24): it sinks out of sight while the
 * page scrolls and rises back once scrolling stops or the finger lifts (src/scripts/case-study/nav.ts).
 * The surface blurs what scrolls under it (backdrop-blur-nav, 40px). Its fill is Figma's grey in multiply,
 * 50% over a cover (surface-caption) and 80% over the pale page (surface-caption-strong): white text on
 * 50% over white is 2.3:1, on 80% 4.6:1. The 80% is the 50% plus a boost layer that fades out while a
 * [data-nav-media] element is under the nav (nav.ts sets data-over-media), so it only changes opacity.
 * design/rules.md → Accessibility.
 */
import HouseSimple from '../icons/HouseSimple.astro';
import HouseSimpleFill from '../icons/HouseSimpleFill.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  previous: CaseStudy;
  next: CaseStudy;
  /** Home lands the wheel on this project (no hash for the first one). */
  homeHref: string;
}

const { previous, next, homeHref } = Astro.props;
const pill =
  'group relative flex items-center justify-center rounded-full border border-line-default text-fg-on-media transition-[border-color,background-color,color] duration-(--duration-fast) ease-out hover:border-surface-raised hover:bg-surface-raised hover:text-fg-primary';
const side = `${pill} w-nav-btn px-4 py-3 text-label-1 font-medium`;
---

<nav aria-label="Projects" class="case-nav pointer-events-none fixed inset-x-0 z-20 flex justify-center" data-case-nav>
  <div class="case-nav__bar pointer-events-auto relative flex items-center gap-1 p-1">
    <span aria-hidden="true" class="case-nav__bg absolute inset-0 rounded-full bg-surface-caption backdrop-blur-nav">
      <span class="case-nav__boost absolute inset-0 rounded-full bg-surface-caption-boost"></span>
    </span>
    <a href={`/work/${previous.id}/`} rel="prev" class:list={[side, 'case-nav__item']} data-case-nav-prev>
      Previous<span class="sr-only">: {previous.data.tocLabel}</span>
    </a>
    <a href={homeHref} class:list={[pill, 'case-nav__item p-3']} aria-label="All projects" data-case-nav-home>
      <HouseSimple class="size-icon-lg group-hover:hidden" />
      <HouseSimpleFill class="hidden size-icon-lg group-hover:block" />
    </a>
    <a href={`/work/${next.id}/`} rel="next" class:list={[side, 'case-nav__item']} data-case-nav-next>
      Next<span class="sr-only">: {next.data.tocLabel}</span>
    </a>
  </div>
</nav>

<style>
  .case-nav {
    bottom: calc(var(--spacing) * 8 + env(safe-area-inset-bottom));
    /*
     * No view-transition-name here: it would make the nav a backdrop root, and the blur would see nothing
     * behind it. page-transition.js names it (case-nav) only while the page slides, so it stays put.
     */
  }

  /*
   * Scrolling down hides it (Vignesh, 2026-10-24): the bar sinks below the screen edge and fades out;
   * scrolling up, it rises back and fades in, in full (duration-base each way; ease-in-out out, ease-out in).
   *
   * No opacity on the bar itself: an ancestor with opacity < 1 is a backdrop root, so the blur would see
   * nothing during the fade and pop back at the end (the flicker of the previous version). The surface,
   * which carries the blur, and each link fade on their own; the bar only moves (translate, which isn't a
   * backdrop root). Keyboard focus inside always shows it.
   */
  .case-nav__bar {
    --nav-drop: calc(100% + var(--spacing) * 8 + env(safe-area-inset-bottom));
    transition: translate var(--duration-base) var(--ease-out);
  }
  .case-nav__bg,
  .case-nav__item {
    transition: opacity var(--duration-base) var(--ease-out);
  }
  [data-case-nav][data-hidden]:not(:focus-within) .case-nav__bar {
    translate: 0 var(--nav-drop);
    pointer-events: none;
    transition-timing-function: var(--ease-in-out);
  }
  [data-case-nav][data-hidden]:not(:focus-within) :is(.case-nav__bg, .case-nav__item) {
    opacity: 0;
    transition-timing-function: var(--ease-in-out);
  }

  /* Over a cover the boost fades out (50% fill); over the page it stays (80%). */
  .case-nav__boost {
    transition: opacity var(--duration-base) var(--ease-out);
  }
  [data-case-nav][data-over-media] .case-nav__boost {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .case-nav__boost {
      transition: none;
    }
  }

  /* Slow device (src/scripts/quality.ts): no backdrop blur. */
  :global(html[data-quality='lite']) .case-nav__bg {
    backdrop-filter: none;
  }
</style>
