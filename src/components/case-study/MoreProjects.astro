---
/**
 * More projects (Figma 234:23083 desktop, 234:10050 mobile): the next three case studies in homepage
 * order, as small project cards (posters only). "See all" goes home: right of the heading on desktop,
 * under the cards on mobile.
 */
import ProjectCardLink from '../home/ProjectCardLink.astro';
import type { CaseStudy } from '../../lib/content';

interface Props {
  entries: CaseStudy[];
}

const { entries } = Astro.props;
const seeAll = 'text-label-1 font-medium text-fg-secondary transition-colors duration-(--duration-fast) ease-out hover:text-fg-primary';
---

<section
  aria-labelledby="more-projects"
  class="more-projects mt-15 desktop:mx-auto desktop:mt-0 desktop:max-w-case-text desktop:pt-22"
>
  <div class="flex items-end justify-between pb-6">
    <h2 id="more-projects" class="text-h5 text-fg-primary">More projects</h2>
    <a href="/" class:list={['hidden desktop:block', seeAll]}>See all</a>
  </div>
  <ul class="grid gap-4 desktop:grid-cols-3 desktop:gap-6">
    {
      entries.map((entry) => (
        <li class="aspect-card desktop:aspect-auto desktop:h-50">
          <ProjectCardLink entry={entry} compact autoplay sizes="(min-width: 75rem) 207px, min(calc(100vw - 48px), 846px)" />
        </li>
      ))
    }
  </ul>
  <a href="/" class:list={['inline-block pt-6 desktop:hidden', seeAll]}>See all</a>
</section>

<style>
  /*
   * At the end of the page the floating nav (CaseNav: 32px up, 56px tall) must clear the last content by a gap
   * (Vignesh, 2026-10-24): 80px on desktop, 60px on mobile. Mobile adds the safe area the nav also sits above.
   */
  .more-projects {
    padding-bottom: calc(var(--spacing) * 37 + env(safe-area-inset-bottom));
  }
  @media (min-width: 75rem) {
    .more-projects {
      padding-bottom: calc(var(--spacing) * 42);
    }
  }
</style>
