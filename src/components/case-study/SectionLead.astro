---
/**
 * Heading + intro paragraph(s) of a case-study section or Solution step (Figma 234:18796, mobile 234:5759).
 */
import { paragraphs } from '../../lib/content';

interface Props {
  heading?: string;
  intro?: string;
  class?: string;
}
const { heading, intro, class: className } = Astro.props;
const lines = paragraphs(intro);
---

{
  (heading || lines.length > 0) && (
    <div class:list={['flex flex-col gap-2 desktop:gap-3', className]}>
      {heading && <h3 class="text-h6 text-fg-primary desktop:text-h5">{heading}</h3>}
      {lines.map((line) => <p class="text-body-3 desktop:text-body-2">{line}</p>)}
    </div>
  )
}
